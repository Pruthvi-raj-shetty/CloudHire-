<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dashboard_background">


    <!-- ===================================================== -->
    <!-- HEADER -->
    <!-- ===================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:background="@android:color/white"
        android:elevation="3dp">


        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:src="@drawable/recruiter_dashboard_menu"
            android:contentDescription="Menu"
            android:padding="10dp" />


        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="NexHire"
            android:textColor="@color/dashboard_text_primary"
            android:textSize="25sp"
            android:textStyle="bold" />


        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp">


            <ImageButton
                android:id="@+id/btnNotifications"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:src="@drawable/recruiter_dashboard_notifications"
                android:contentDescription="Notifications"
                android:padding="10dp" />


            <TextView
                android:id="@+id/txtNotificationBadge"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="top|end"
                android:gravity="center"
                android:text="0"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/recruiter_dashboard_notification_badge"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- SCROLLABLE CONTENT -->
    <!-- ===================================================== -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="26dp"
            android:paddingBottom="24dp">


            <!-- ================================================= -->
            <!-- GREETING -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/txtGreeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Good morning, Recruiter 👋"
                android:textColor="@color/dashboard_text_primary"
                android:textSize="27sp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/txtRecruiterSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Manage your hiring efficiently"
                android:textColor="@color/dashboard_text_secondary"
                android:textSize="16sp" />


            <!-- ================================================= -->
            <!-- POST JOB -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/btnPostJob"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="+  Post a New Job"
                android:textColor="@android:color/white"
                android:textSize="17sp"
                android:textStyle="bold"
                android:background="@drawable/recruiter_dashboard_button"
                android:clickable="true"
                android:focusable="true" />


            <!-- ================================================= -->
            <!-- HIRING OVERVIEW -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">


                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Hiring Overview"
                    android:textColor="@color/dashboard_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/btnViewAllJobs"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="48dp"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="View All  →"
                    android:textColor="@color/dashboard_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- STATISTICS 2 x 2 -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">


                <!-- ROW 1 -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">


                    <!-- JOBS -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="135dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical"
                        android:padding="18dp"
                        android:background="@drawable/recruiter_dashboard_card">


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💼"
                            android:textSize="23sp" />


                        <TextView
                            android:id="@+id/txtJobsCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="0"
                            android:textColor="@color/dashboard_text_primary"
                            android:textSize="26sp"
                            android:textStyle="bold" />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Jobs"
                            android:textColor="@color/dashboard_text_secondary"
                            android:textSize="14sp" />

                    </LinearLayout>


                    <!-- APPLICANTS -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="135dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical"
                        android:padding="18dp"
                        android:background="@drawable/recruiter_dashboard_card">


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="👥"
                            android:textSize="23sp" />


                        <TextView
                            android:id="@+id/txtApplicantsCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="0"
                            android:textColor="@color/dashboard_text_primary"
                            android:textSize="26sp"
                            android:textStyle="bold" />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Applicants"
                            android:textColor="@color/dashboard_text_secondary"
                            android:textSize="14sp" />

                    </LinearLayout>

                </LinearLayout>


                <!-- ROW 2 -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">


                    <!-- SHORTLISTED -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="135dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical"
                        android:padding="18dp"
                        android:background="@drawable/recruiter_dashboard_card">


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⭐"
                            android:textSize="23sp" />


                        <TextView
                            android:id="@+id/txtShortlistedCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="0"
                            android:textColor="@color/dashboard_text_primary"
                            android:textSize="26sp"
                            android:textStyle="bold" />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Shortlisted"
                            android:textColor="@color/dashboard_text_secondary"
                            android:textSize="14sp" />

                    </LinearLayout>


                    <!-- INTERVIEWS -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="135dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical"
                        android:padding="18dp"
                        android:background="@drawable/recruiter_dashboard_card">


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📅"
                            android:textSize="23sp" />


                        <TextView
                            android:id="@+id/txtInterviewsCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="0"
                            android:textColor="@color/dashboard_text_primary"
                            android:textSize="26sp"
                            android:textStyle="bold" />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Interviews"
                            android:textColor="@color/dashboard_text_secondary"
                            android:textSize="14sp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- ACTIVE JOBS -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">


                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Active Jobs"
                    android:textColor="@color/dashboard_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/btnViewAllJobs2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View All  →"
                    android:textColor="@color/dashboard_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <LinearLayout
                android:id="@+id/activeJobsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical" />


            <!-- ================================================= -->
            <!-- RECENT APPLICANTS -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">


                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Recent Applicants"
                    android:textColor="@color/dashboard_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/btnViewAllApplicants"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View All  →"
                    android:textColor="@color/dashboard_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <LinearLayout
                android:id="@+id/applicantsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical" />


            <!-- ================================================= -->
            <!-- UPCOMING INTERVIEWS -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">


                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Upcoming Interviews"
                    android:textColor="@color/dashboard_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/btnViewAllInterviews"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View All  →"
                    android:textColor="@color/dashboard_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <LinearLayout
                android:id="@+id/interviewsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical" />


            <!-- ================================================= -->
            <!-- QUICK ACTIONS -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Quick Actions"
                android:textColor="@color/dashboard_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">


                <TextView
                    android:id="@+id/quickPostJob"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:gravity="center"
                    android:text="+ Post Job"
                    android:textColor="@color/dashboard_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/recruiter_dashboard_quick_action" />


                <TextView
                    android:id="@+id/quickApplicants"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:gravity="center"
                    android:text="Applicants"
                    android:textColor="@color/dashboard_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/recruiter_dashboard_quick_action" />


                <TextView
                    android:id="@+id/quickInterviews"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:gravity="center"
                    android:text="Interviews"
                    android:textColor="@color/dashboard_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/recruiter_dashboard_quick_action" />


                <TextView
                    android:id="@+id/quickShortlisted"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:gravity="center"
                    android:text="Shortlisted"
                    android:textColor="@color/dashboard_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/recruiter_dashboard_quick_action" />

            </LinearLayout>


        </LinearLayout>

    </ScrollView>


    <!-- ===================================================== -->
    <!-- BOTTOM NAVIGATION -->
    <!-- ===================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@android:color/white"
        android:elevation="8dp">

        <!-- Home -->
        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌂\nHome"
            android:textColor="@color/dashboard_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:clickable="true" />

        <!-- Jobs -->
        <TextView
            android:id="@+id/navJobs"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="💼\nJobs"
            android:textColor="@color/dashboard_text_secondary"
            android:textSize="12sp"
            android:clickable="true" />

        <!-- Applicants -->
        <TextView
            android:id="@+id/navApplicants"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="👥\nApplicants"
            android:textColor="@color/dashboard_text_secondary"
            android:textSize="12sp"
            android:clickable="true" />

        <!-- Profile -->
        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/recruiter_dashboard_person"
                app:tint="@color/dashboard_text_secondary"
                android:contentDescription="Profile" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Profile"
                android:textColor="@color/dashboard_text_secondary"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>