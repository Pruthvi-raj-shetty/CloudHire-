<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:orientation="vertical"
    android:background="#F5F7FB">


    <!-- ===================================================== -->
    <!-- TOP BAR -->
    <!-- ===================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"

        android:orientation="horizontal"
        android:gravity="center_vertical"

        android:paddingStart="16dp"
        android:paddingEnd="16dp"

        android:background="#FFFFFF"
        android:elevation="3dp">


        <ImageButton
            android:id="@+id/btnBack"

            android:layout_width="48dp"
            android:layout_height="48dp"

            android:background="?attr/selectableItemBackgroundBorderless"

            android:contentDescription="Back"

            android:src="@drawable/ic_arrow_back" />


        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:gravity="center"

            android:text="Apply for Job"

            android:textColor="#172554"

            android:textSize="20sp"
            android:textStyle="bold" />


        <View
            android:layout_width="40dp"
            android:layout_height="40dp" />

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- CONTENT -->
    <!-- ===================================================== -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"

        android:layout_weight="1"

        android:fillViewport="true">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:padding="20dp">


            <!-- ================================================= -->
            <!-- TITLE -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/txtJobTitle"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="Job Title"

                android:textColor="#172554"

                android:textSize="25sp"
                android:textStyle="bold" />


            <!-- ================================================= -->
            <!-- JOB INFORMATION CARD -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="20dp"

                android:orientation="vertical"

                android:padding="18dp"

                android:background="#FFFFFF"

                android:elevation="2dp">


                <TextView
                    android:id="@+id/txtCompanyName"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:text="Company"

                    android:textColor="#4B5563"
                    android:textSize="15sp" />


                <TextView
                    android:id="@+id/txtLocation"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="10dp"

                    android:text="Location"

                    android:textColor="#4B5563"
                    android:textSize="15sp" />


            </LinearLayout>


            <!-- ================================================= -->
            <!-- APPLICATION -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="25dp"

                android:text="Your Application"

                android:textColor="#172554"

                android:textSize="20sp"
                android:textStyle="bold" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="8dp"

                android:text="Confirm your details and select your resume."

                android:textColor="#6B7280"

                android:textSize="14sp" />


            <!-- ================================================= -->
            <!-- FULL NAME -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="20dp"

                android:text="Full Name"

                android:textColor="#374151"

                android:textSize="14sp"
                android:textStyle="bold" />


            <EditText
                android:id="@+id/etFullName"

                android:layout_width="match_parent"
                android:layout_height="52dp"

                android:layout_marginTop="8dp"

                android:background="#FFFFFF"

                android:hint="Enter your full name"

                android:paddingStart="14dp"
                android:paddingEnd="14dp"

                android:textColor="#172554"
                android:textColorHint="#94A3B8"

                android:textSize="15sp"

                android:inputType="textPersonName" />


            <!-- ================================================= -->
            <!-- EMAIL -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="16dp"

                android:text="Email"

                android:textColor="#374151"

                android:textSize="14sp"
                android:textStyle="bold" />


            <EditText
                android:id="@+id/etEmail"

                android:layout_width="match_parent"
                android:layout_height="52dp"

                android:layout_marginTop="8dp"

                android:background="#FFFFFF"

                android:hint="Enter your email"

                android:paddingStart="14dp"
                android:paddingEnd="14dp"

                android:textColor="#172554"
                android:textColorHint="#94A3B8"

                android:textSize="15sp"

                android:inputType="textEmailAddress" />


            <!-- ================================================= -->
            <!-- COVER LETTER -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="16dp"

                android:text="Cover Letter (Optional)"

                android:textColor="#374151"

                android:textSize="14sp"
                android:textStyle="bold" />


            <EditText
                android:id="@+id/etCoverLetter"

                android:layout_width="match_parent"
                android:layout_height="120dp"

                android:layout_marginTop="8dp"

                android:background="#FFFFFF"

                android:gravity="top"

                android:hint="Write a short cover letter..."

                android:padding="14dp"

                android:textColor="#172554"
                android:textColorHint="#94A3B8"

                android:textSize="15sp"

                android:inputType="textMultiLine" />


            <!-- ================================================= -->
            <!-- RESUME -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="18dp"

                android:text="Resume"

                android:textColor="#374151"

                android:textSize="14sp"
                android:textStyle="bold" />


            <LinearLayout
                android:id="@+id/layoutUploadResume"

                android:layout_width="match_parent"
                android:layout_height="90dp"

                android:layout_marginTop="8dp"

                android:background="#F8FAFC"

                android:gravity="center"

                android:orientation="vertical"

                android:padding="8dp">


                <TextView
                    android:id="@+id/txtResumeName"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:ellipsize="end"

                    android:gravity="center"

                    android:maxLines="1"

                    android:text="Upload Resume (PDF)"

                    android:textColor="#2563EB"

                    android:textSize="14sp"

                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/txtResumeStatus"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="5dp"

                    android:gravity="center"

                    android:text="Max file size 5MB"

                    android:textColor="#94A3B8"

                    android:textSize="12sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- SUBMIT -->
            <!-- ================================================= -->

            <Button
                android:id="@+id/btnSubmitApplication"

                android:layout_width="match_parent"
                android:layout_height="52dp"

                android:layout_marginTop="18dp"

                android:text="Submit Application"

                android:textAllCaps="false"

                android:textColor="#FFFFFF"

                android:textSize="16sp"

                android:textStyle="bold"

                android:backgroundTint="#2563EB" />


        </LinearLayout>

    </ScrollView>

</LinearLayout>