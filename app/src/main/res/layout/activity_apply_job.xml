<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:orientation="vertical"
    android:background="#F5F7FB">

    <!-- TOP BAR -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"

        android:orientation="horizontal"
        android:gravity="center_vertical"

        android:paddingStart="16dp"
        android:paddingEnd="16dp"

        android:background="#FFFFFF"
        android:elevation="3dp">

        <ImageButton
            android:id="@+id/btnBack"

            android:layout_width="48dp"
            android:layout_height="48dp"

            android:background="?attr/selectableItemBackgroundBorderless"

            android:src="@android:drawable/ic_media_previous"

            android:contentDescription="Back"

            app:tint="#172554"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:gravity="center"

            android:text="Apply for Job"

            android:textColor="#172554"

            android:textSize="20sp"
            android:textStyle="bold"/>

        <View
            android:layout_width="48dp"
            android:layout_height="48dp"/>

    </LinearLayout>


    <!-- CONTENT -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"

        android:layout_weight="1"

        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:padding="20dp">


            <!-- TITLE -->

            <TextView
                android:id="@+id/txtApplyTitle"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="Apply for Job"

                android:textColor="#172554"

                android:textSize="25sp"
                android:textStyle="bold"/>


            <!-- JOB INFORMATION CARD -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="20dp"

                android:orientation="vertical"

                android:padding="18dp"

                android:background="#FFFFFF"

                android:elevation="2dp">


                <TextView
                    android:id="@+id/txtApplyCompany"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:text="Company:"

                    android:textColor="#4B5563"
                    android:textSize="15sp"/>


                <TextView
                    android:id="@+id/txtApplyLocation"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="10dp"

                    android:text="Location:"

                    android:textColor="#4B5563"
                    android:textSize="15sp"/>


                <TextView
                    android:id="@+id/txtApplyEmployment"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="10dp"

                    android:text="Employment Type:"

                    android:textColor="#4B5563"
                    android:textSize="15sp"/>


                <TextView
                    android:id="@+id/txtApplyExperience"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="10dp"

                    android:text="Experience:"

                    android:textColor="#4B5563"
                    android:textSize="15sp"/>


                <TextView
                    android:id="@+id/txtApplySkills"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="10dp"

                    android:text="Skills:"

                    android:textColor="#4B5563"
                    android:textSize="15sp"/>

            </LinearLayout>


            <!-- APPLICATION -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="25dp"

                android:text="Your Application"

                android:textColor="#172554"

                android:textSize="20sp"
                android:textStyle="bold"/>


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="8dp"

                android:text="Confirm your details and select your resume."

                android:textColor="#6B7280"

                android:textSize="14sp"/>


            <!-- RESUME -->

            <Button
                android:id="@+id/btnSelectResume"

                android:layout_width="match_parent"
                android:layout_height="50dp"

                android:layout_marginTop="18dp"

                android:text="Select Resume"

                android:textAllCaps="false"

                android:textColor="#FFFFFF"

                android:textStyle="bold"

                android:backgroundTint="#2563EB"/>


            <!-- SUBMIT -->

            <Button
                android:id="@+id/btnSubmitApplication"

                android:layout_width="match_parent"
                android:layout_height="50dp"

                android:layout_marginTop="14dp"

                android:text="Submit Application"

                android:textAllCaps="false"

                android:textColor="#FFFFFF"

                android:textStyle="bold"

                android:backgroundTint="#2563EB"/>

        </LinearLayout>

    </ScrollView>

</LinearLayout>