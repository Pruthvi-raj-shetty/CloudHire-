<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="#F7F9FC"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:overScrollMode="ifContentScrolls"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"

        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="40dp">

        <!-- ============================================== -->
        <!-- BACK BUTTON -->
        <!-- ============================================== -->

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start"

            android:background="@android:color/transparent"
            android:contentDescription="Back"

            android:padding="12dp"
            android:src="@android:drawable/ic_menu_revert"

            android:clickable="true"
            android:focusable="true" />


        <!-- ============================================== -->
        <!-- LOGO -->
        <!-- ============================================== -->

        <ImageView
            android:id="@+id/imgCandidateLogo"

            android:layout_width="88dp"
            android:layout_height="88dp"

            android:layout_gravity="center"
            android:layout_marginTop="4dp"

            android:src="@drawable/ic_cloudhire_candidate"

            android:contentDescription="CloudHire Logo" />


        <!-- ============================================== -->
        <!-- APP NAME -->
        <!-- ============================================== -->

        <TextView
            android:id="@+id/txtAppName"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_gravity="center"
            android:layout_marginTop="8dp"

            android:text="CloudHire"

            android:textColor="#1D4ED8"
            android:textSize="28sp"
            android:textStyle="bold" />


        <!-- ============================================== -->
        <!-- TITLE -->
        <!-- ============================================== -->

        <TextView
            android:id="@+id/txtLoginTitle"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_gravity="center"
            android:layout_marginTop="12dp"

            android:text="Candidate Login"

            android:textColor="#111827"
            android:textSize="23sp"
            android:textStyle="bold" />


        <!-- ============================================== -->
        <!-- SUBTITLE -->
        <!-- ============================================== -->


        <!-- ============================================== -->
        <!-- LOGIN CARD -->
        <!-- ============================================== -->


        <!-- ============================================== -->
        <!-- BOTTOM TEXT -->
        <!-- ============================================== -->

        <TextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_gravity="center"
            android:layout_marginTop="5dp"

            android:text="Welcome back! Please login to continue"

            android:textColor="#6B7280"
            android:textSize="13sp" />

        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="24dp"

            android:background="#FFFFFF"

            android:elevation="6dp"

            android:orientation="vertical"

            android:paddingStart="20dp"
            android:paddingTop="22dp"
            android:paddingEnd="20dp"
            android:paddingBottom="22dp">


            <!-- ========================================== -->
            <!-- EMAIL LABEL -->
            <!-- ========================================== -->

            <TextView

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Email Address"

                android:textColor="#1F2937"
                android:textSize="13sp"
                android:textStyle="bold" />


            <!-- ========================================== -->
            <!-- EMAIL -->
            <!-- ========================================== -->

            <com.google.android.material.textfield.TextInputLayout

                android:id="@+id/emailLayout"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="7dp"

                app:boxBackgroundMode="outline"

                app:boxCornerRadiusBottomEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusTopStart="10dp"

                app:boxStrokeColor="#D1D5DB"

                app:hintEnabled="false"

                app:startIconDrawable="@android:drawable/ic_dialog_email">


                <com.google.android.material.textfield.TextInputEditText

                    android:id="@+id/etEmail"

                    android:layout_width="match_parent"
                    android:layout_height="54dp"

                    android:hint="Enter your email"

                    android:imeOptions="actionNext"

                    android:inputType="textEmailAddress"

                    android:paddingStart="10dp"

                    android:paddingEnd="10dp"
                    android:singleLine="true"

                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>


            <!-- ========================================== -->
            <!-- PASSWORD LABEL -->
            <!-- ========================================== -->

            <TextView

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="18dp"

                android:text="Password"

                android:textColor="#1F2937"
                android:textSize="13sp"
                android:textStyle="bold" />


            <!-- ========================================== -->
            <!-- PASSWORD -->
            <!-- ========================================== -->

            <com.google.android.material.textfield.TextInputLayout

                android:id="@+id/passwordLayout"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="7dp"

                app:boxBackgroundMode="outline"

                app:boxCornerRadiusBottomEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusTopStart="10dp"

                app:boxStrokeColor="#D1D5DB"

                app:endIconMode="password_toggle"

                app:hintEnabled="false"

                app:startIconDrawable="@android:drawable/ic_lock_lock">


                <com.google.android.material.textfield.TextInputEditText

                    android:id="@+id/etPassword"

                    android:layout_width="match_parent"
                    android:layout_height="54dp"

                    android:hint="Enter your password"

                    android:imeOptions="actionDone"

                    android:inputType="textPassword"

                    android:paddingStart="10dp"

                    android:paddingEnd="10dp"
                    android:singleLine="true"

                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>


            <!-- ========================================== -->
            <!-- FORGOT PASSWORD -->
            <!-- ========================================== -->

            <TextView

                android:id="@+id/txtForgotPassword"

                android:layout_width="match_parent"
                android:layout_height="48dp"

                android:layout_marginTop="3dp"

                android:clickable="true"

                android:focusable="true"
                android:gravity="center_vertical|end"

                android:paddingStart="12dp"
                android:paddingEnd="4dp"

                android:text="Forgot Password?"

                android:textColor="#2563EB"

                android:textSize="12sp"

                android:textStyle="bold" />


            <!-- ========================================== -->
            <!-- LOGIN BUTTON -->
            <!-- ========================================== -->

            <Button

                android:id="@+id/btnLogin"

                android:layout_width="match_parent"
                android:layout_height="54dp"

                android:layout_marginTop="7dp"

                android:backgroundTint="#2563EB"

                android:text="Login"

                android:textAllCaps="false"

                android:textColor="#FFFFFF"

                android:textSize="15sp"

                android:textStyle="bold" />


            <!-- ========================================== -->
            <!-- OR -->
            <!-- ========================================== -->

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="48dp"

                android:layout_marginTop="10dp"

                android:gravity="center_vertical"

                android:orientation="horizontal">


                <View

                    android:layout_width="0dp"
                    android:layout_height="1dp"

                    android:layout_weight="1"

                    android:background="#E5E7EB" />


                <TextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"

                    android:text="OR"

                    android:textColor="#9CA3AF"

                    android:textSize="11sp" />


                <View

                    android:layout_width="0dp"
                    android:layout_height="1dp"

                    android:layout_weight="1"

                    android:background="#E5E7EB" />

            </LinearLayout>


            <!-- ========================================== -->
            <!-- REGISTER -->
            <!-- ========================================== -->

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="48dp"

                android:gravity="center"

                android:orientation="horizontal">


                <TextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="Don't have an account? "

                    android:textColor="#4B5563"

                    android:textSize="12sp" />


                <TextView

                    android:id="@+id/txtRegister"

                    android:layout_width="wrap_content"
                    android:layout_height="48dp"

                    android:clickable="true"

                    android:focusable="true"
                    android:gravity="center"

                    android:paddingStart="7dp"
                    android:paddingEnd="7dp"

                    android:text="Register"

                    android:textColor="#2563EB"

                    android:textSize="12sp"

                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <TextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_gravity="center"

            android:layout_marginTop="22dp"

            android:text="Secure • Simple • Smart Hiring"

            android:textColor="#9CA3AF"

            android:textSize="11sp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>