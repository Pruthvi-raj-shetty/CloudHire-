<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- BACK -->

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="Back"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_revert" />

        <!-- TITLE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="18dp"
            android:text="Forgot Password"
            android:textColor="#111827"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- STEP -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:text="Step 3 of 5"
            android:textColor="#4F46E5"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- OTP ICON -->

        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:layout_marginTop="30dp"
            android:contentDescription="OTP"
            android:src="@android:drawable/ic_lock_lock" />

        <!-- HEADING -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:text="Enter OTP"
            android:textColor="#111827"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- DESCRIPTION -->

        <TextView
            android:id="@+id/txtOtpEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Enter the 6-digit OTP sent to your email"
            android:textColor="#6B7280"
            android:textSize="14sp" />

        <!-- OTP -->

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etOtp"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center"
                android:hint="Enter 6-digit OTP"
                android:inputType="number"
                android:maxLength="6"
                android:singleLine="true"
                android:textSize="20sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- TIMER -->

        <TextView
            android:id="@+id/txtOtpTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="14dp"
            android:text="OTP expires in 00:30"
            android:textColor="#6B7280"
            android:textSize="14sp" />

        <!-- RESEND -->

        <TextView
            android:id="@+id/txtResendOtp"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:layout_marginTop="4dp"
            android:clickable="false"
            android:focusable="false"
            android:gravity="center"
            android:padding="12dp"
            android:text="Resend OTP"
            android:textColor="#9CA3AF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- VERIFY -->

        <Button
            android:id="@+id/btnVerifyOtp"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:backgroundTint="#5B45D9"
            android:text="Verify OTP"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>