<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dashboard_background">

    <!-- HEADER -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@android:color/white"
        android:elevation="3dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp">

        <ImageButton
            android:id="@+id/btnApplicationBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_arrow_back"
            android:padding="10dp"
            app:tint="@color/dashboard_text_primary"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Application Details"
            android:textColor="@color/dashboard_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <View
            android:layout_width="48dp"
            android:layout_height="48dp" />

    </LinearLayout>


    <!-- CONTENT -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- PROFILE CARD -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:background="@drawable/recruiter_dashboard_card">

                <ImageView
                    android:id="@+id/imgCandidate"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:padding="10dp"
                    android:src="@drawable/recruiter_dashboard_person"
                    android:contentDescription="Candidate" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtCandidateName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#101828"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtProfessionalTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="#667085"
                        android:textSize="14sp" />

                </LinearLayout>

            </LinearLayout>


            <!-- APPLICATION INFO -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Application Information"
                android:textColor="#101828"
                android:textSize="19sp"
                android:textStyle="bold" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/recruiter_dashboard_card">

                <TextView
                    android:id="@+id/txtJobApplied"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#344054"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txtCompany"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="#667085"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txtLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#667085"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txtAppliedDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#667085"
                    android:textSize="14sp" />

            </LinearLayout>


            <!-- CONTACT -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Candidate Contact"
                android:textColor="#101828"
                android:textSize="19sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/recruiter_dashboard_card">

                <TextView
                    android:id="@+id/txtCandidateEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#344054"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txtCandidatePhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="#344054"
                    android:textSize="14sp" />

            </LinearLayout>


            <!-- RESUME -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Resume"
                android:textColor="#101828"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnViewResume"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="View Resume"
                android:textColor="#2563EB"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_quick_action" />


            <!-- STATUS -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Application Status"
                android:textColor="#101828"
                android:textSize="19sp"
                android:textStyle="bold" />

            <AutoCompleteTextView
                android:id="@+id/actApplicationStatus"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_applicant_search"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:hint="Select status"
                android:textColor="#101828"
                android:textColorHint="#667085"
                android:textSize="14sp"
                android:inputType="none" />


            <TextView
                android:id="@+id/btnUpdateStatus"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="Update Status"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/bg_primary_button" />

            <View
                android:layout_width="match_parent"
                android:layout_height="30dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>