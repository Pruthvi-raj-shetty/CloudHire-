<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F8FF">

    <!-- ================= LOGO ================= -->

    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_marginTop="48dp"
        android:contentDescription="@string/logo"
        android:src="@mipmap/ic_launcher"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ================= APP NAME ================= -->

    <TextView
        android:id="@+id/txtAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/app_title"
        android:textColor="#1E3A8A"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/imgLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ================= WELCOME ================= -->

    <TextView
        android:id="@+id/txtWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="42dp"
        android:text="@string/welcome"
        android:textColor="#101828"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/txtAppName"
        app:layout_constraintStart_toStartOf="parent" />


    <!-- ================= DESCRIPTION ================= -->

    <TextView
        android:id="@+id/txtDesc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="@string/choose_role"
        android:textColor="#2563EB"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="@id/txtWelcome"
        app:layout_constraintTop_toBottomOf="@id/txtWelcome" />


    <!-- ================================================= -->
    <!--                  CANDIDATE CARD                   -->
    <!-- ================================================= -->

    <LinearLayout
        android:id="@+id/layoutCandidate"
        android:layout_width="0dp"
        android:layout_height="118dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_candidate_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        app:layout_constraintTop_toBottomOf="@id/txtDesc"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Candidate Icon Background -->

        <FrameLayout
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/bg_candidate_icon">

            <!-- Candidate Logo -->

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:contentDescription="@string/candidate"
                android:src="@drawable/ic_cloudhire_candidate" />

        </FrameLayout>


        <!-- Candidate Text -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/candidate"
                android:textColor="#101828"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/candidate_desc"
                android:textColor="#667085"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Explore opportunities →"
                android:textColor="#2563EB"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- Candidate Arrow -->

        <TextView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_candidate_arrow"
            android:gravity="center"
            android:text="›"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold" />

    </LinearLayout>


    <!-- ================================================= -->
    <!--                   RECRUITER CARD                  -->
    <!-- ================================================= -->

    <LinearLayout
        android:id="@+id/layoutRecruiter"
        android:layout_width="0dp"
        android:layout_height="118dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_recruiter_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        app:layout_constraintTop_toBottomOf="@id/layoutCandidate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Recruiter Icon Background -->

        <FrameLayout
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/bg_recruiter_icon">

            <!-- Recruiter Logo -->

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:contentDescription="@string/recruiter"
                android:src="@drawable/ic_nexhire_recruiter" />

        </FrameLayout>


        <!-- Recruiter Text -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/recruiter"
                android:textColor="#101828"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/recruiter_desc"
                android:textColor="#667085"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Find top talent →"
                android:textColor="#0F766E"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- Recruiter Arrow -->

        <TextView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_recruiter_arrow"
            android:gravity="center"
            android:text="›"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>