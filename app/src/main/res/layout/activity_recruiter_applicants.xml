<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dashboard_background">

    <!-- ================================================= -->
    <!-- TOP HEADER -->
    <!-- ================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@android:color/white"
        android:elevation="3dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp">

        <!-- BACK BUTTON -->

        <ImageButton
            android:id="@+id/btnApplicantsBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_arrow_back"
            android:scaleType="centerInside"
            android:padding="10dp"
            app:tint="@color/dashboard_text_primary"
            android:contentDescription="Back" />

        <!-- TITLE -->

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Applicants"
            android:textColor="@color/dashboard_text_primary"
            android:textSize="25sp"
            android:textStyle="bold" />

        <!-- NOTIFICATION -->

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp">

            <ImageButton
                android:id="@+id/btnApplicantsNotifications"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:src="@drawable/recruiter_dashboard_notifications"
                android:scaleType="centerInside"
                android:padding="10dp"
                android:contentDescription="Notifications" />

            <TextView
                android:id="@+id/txtApplicantsNotificationBadge"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="top|end"
                android:gravity="center"
                android:text="0"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/recruiter_dashboard_notification_badge"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>


    <!-- ================================================= -->
    <!-- SCROLLABLE CONTENT -->
    <!-- ================================================= -->

    <ScrollView
        android:id="@+id/applicantsScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="24dp">

            <!-- PAGE HEADING -->

            <TextView
                android:id="@+id/txtApplicantsHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Applicants"
                android:textColor="@color/dashboard_text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtApplicantsSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Review candidates who applied to your jobs"
                android:textColor="@color/dashboard_text_secondary"
                android:textSize="15sp" />


            <!-- SEARCH -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/bg_applicant_search">

                <ImageView
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:src="@drawable/ic_search"
                    android:contentDescription="Search" />

                <EditText
                    android:id="@+id/etApplicantSearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="9dp"
                    android:background="@android:color/transparent"
                    android:hint="Search applicants..."
                    android:singleLine="true"
                    android:textColor="#101828"
                    android:textColorHint="#98A2B3"
                    android:textSize="14sp"
                    android:inputType="text" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- STATUS FILTERS -->
            <!-- ================================================= -->

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/filterAll"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="All"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_filter_active" />

                    <TextView
                        android:id="@+id/filterApplied"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Applied"
                        android:textColor="#475467"
                        android:textSize="13sp"
                        android:background="@drawable/bg_filter_inactive" />

                    <TextView
                        android:id="@+id/filterShortlisted"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Shortlisted"
                        android:textColor="#475467"
                        android:textSize="13sp"
                        android:background="@drawable/bg_filter_inactive" />

                    <TextView
                        android:id="@+id/filterInterview"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Interview"
                        android:textColor="#475467"
                        android:textSize="13sp"
                        android:background="@drawable/bg_filter_inactive" />

                    <TextView
                        android:id="@+id/filterRejected"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Rejected"
                        android:textColor="#475467"
                        android:textSize="13sp"
                        android:background="@drawable/bg_filter_inactive" />

                </LinearLayout>

            </HorizontalScrollView>


            <!-- SECTION TITLE -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Applicants"
                    android:textColor="@color/dashboard_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtApplicantCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/dashboard_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- LOADING -->

            <ProgressBar
                android:id="@+id/progressApplicants"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:layout_marginTop="32dp"
                android:visibility="gone" />


            <!-- APPLICANT CARDS -->

            <LinearLayout
                android:id="@+id/applicantsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical" />


            <!-- EMPTY STATE -->

            <LinearLayout
                android:id="@+id/emptyApplicants"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone"
                android:padding="20dp">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/recruiter_dashboard_people"
                    android:alpha="0.55"
                    android:contentDescription="No applicants" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="No applicants yet"
                    android:textColor="#101828"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtEmptyApplicants"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Applicants for your jobs will appear here."
                    android:textColor="#667085"
                    android:textSize="14sp" />

            </LinearLayout>


            <!-- ERROR STATE -->

            <LinearLayout
                android:id="@+id/errorApplicants"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txtApplicantError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Unable to load applicants"
                    android:textColor="#B42318"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/btnRetryApplicants"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:text="Retry"
                    android:textColor="#2563EB"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_quick_action" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>


    <!-- ================================================= -->
    <!-- BOTTOM NAVIGATION -->
    <!-- ================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@android:color/white"
        android:elevation="8dp">

        <!-- HOME -->

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/recruiter_dashboard_home"
                app:tint="@color/dashboard_primary"
                android:contentDescription="Home" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Home"
                android:textColor="@color/dashboard_text_secondary"
                android:textSize="12sp" />

        </LinearLayout>


        <!-- JOBS -->

        <LinearLayout
            android:id="@+id/navJobs"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/recruiter_dashboard_briefcase"
                app:tint="#A85D36"
                android:contentDescription="Jobs" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="My Jobs"
                android:textColor="@color/dashboard_text_secondary"
                android:textSize="12sp" />

        </LinearLayout>


        <!-- APPLICANTS - ACTIVE -->

        <LinearLayout
            android:id="@+id/navApplicants"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/recruiter_dashboard_people"
                app:tint="@color/dashboard_primary"
                android:contentDescription="Applicants" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Applicants"
                android:textColor="@color/dashboard_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- PROFILE -->

        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/recruiter_dashboard_person"
                app:tint="@color/dashboard_text_secondary"
                android:contentDescription="Profile" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Profile"
                android:textColor="@color/dashboard_text_secondary"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>