<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FB">

    <!-- ================= HEADER ================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:background="#FFFFFF"
        android:elevation="4dp">

        <!-- BACK BUTTON -->

        <ImageButton
            android:id="@+id/btnJobsBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_arrow_back"
            android:padding="10dp"
            app:tint="@color/dashboard_text_primary"
            android:contentDescription="Back" />

        <!-- TITLE -->

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="My Jobs"
            android:textColor="@color/dashboard_text_primary"
            android:textSize="25sp"
            android:textStyle="bold" />

        <!-- NOTIFICATION -->

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp">

            <ImageButton
                android:id="@+id/btnJobsNotifications"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:src="@drawable/recruiter_dashboard_notifications"
                android:padding="10dp"
                android:contentDescription="Notifications" />

            <TextView
                android:id="@+id/txtJobsNotificationBadge"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="top|end"
                android:gravity="center"
                android:text="0"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/recruiter_dashboard_notification_badge"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>


    <!-- ================= CONTENT ================= -->

    <ScrollView
        android:id="@+id/jobsScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="28dp"
            android:paddingBottom="30dp">

            <!-- PAGE HEADING -->

            <TextView
                android:id="@+id/txtManageJobs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Manage Your Jobs"
                android:textColor="#111827"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtManageJobsSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="View and manage all your posted jobs"
                android:textColor="#6B7280"
                android:textSize="15sp" />


            <!-- STATUS FILTERS -->

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/filterJobsAll"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:text="All Jobs"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_filter_active" />

                    <TextView
                        android:id="@+id/filterJobsOpen"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:gravity="center"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="Active"
                        android:textColor="#6B7280"
                        android:textSize="13sp"
                        android:background="@drawable/bg_filter_inactive" />

                    <TextView
                        android:id="@+id/filterJobsClosed"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:gravity="center"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="Closed"
                        android:textColor="#6B7280"
                        android:textSize="13sp"
                        android:background="@drawable/bg_filter_inactive" />

                </LinearLayout>

            </HorizontalScrollView>


            <!-- POST JOB BUTTON -->

            <TextView
                android:id="@+id/btnPostJob"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="+  Post a Job"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/recruiter_dashboard_button"
                android:clickable="true"
                android:focusable="true" />


            <!-- JOB SECTION -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Posted Jobs"
                    android:textColor="#111827"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtJobCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3 Jobs"
                    android:textColor="#2563EB"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- JOB CARDS WILL BE ADDED HERE -->

            <LinearLayout
                android:id="@+id/jobsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical" />


            <!-- ================= EMPTY STATE ================= -->

            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="60dp"
                android:paddingBottom="60dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/recruiter_dashboard_briefcase"
                    android:contentDescription="No jobs" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="No jobs posted yet"
                    android:textColor="#111827"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Create your first job posting"
                    android:textColor="#6B7280"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btnEmptyPostJob"
                    android:layout_width="190dp"
                    android:layout_height="50dp"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:text="+  Post a Job"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:background="@drawable/recruiter_dashboard_button"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>


    <!-- ================= BOTTOM NAVIGATION ================= -->

    <!-- ===================================================== -->
    <!-- BOTTOM NAVIGATION -->
    <!-- ===================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@android:color/white"
        android:elevation="8dp">


        <!-- ================= HOME ================= -->

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/recruiter_dashboard_home"
                app:tint="@color/dashboard_primary"
                android:contentDescription="Home" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Home"
                android:textColor="@color/dashboard_text_secondary"
                android:textSize="12sp" />

        </LinearLayout>


        <!-- ================= JOBS ================= -->

        <LinearLayout
            android:id="@+id/navJobs"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/recruiter_dashboard_briefcase"
                android:scaleType="centerInside"
                app:tint="#A85D36"
                android:contentDescription="Jobs" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="My Jobs"
                android:textColor="@color/dashboard_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- ================= APPLICANTS ================= -->

        <LinearLayout
            android:id="@+id/navApplicants"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/recruiter_dashboard_people"
                app:tint="@color/dashboard_primary"
                android:contentDescription="Applicants" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Applicants"
                android:textColor="@color/dashboard_text_secondary"
                android:textSize="12sp" />

        </LinearLayout>


        <!-- ================= PROFILE ================= -->

        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/recruiter_dashboard_person"
                android:scaleType="centerInside"
                app:tint="@color/dashboard_text_secondary"
                android:contentDescription="Profile" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Profile"
                android:textColor="@color/dashboard_text_secondary"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

    </LinearLayout>

