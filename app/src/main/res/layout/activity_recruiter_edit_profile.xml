<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FB"
    android:fitsSystemWindows="true">

    <!-- ================= HEADER ================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#FFFFFF"
        android:elevation="4dp">

        <ImageButton
            android:id="@+id/btnEditBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_arrow_back"
            android:padding="12dp"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Edit Profile"
            android:textColor="#111827"
            android:textSize="21sp"
            android:textStyle="bold" />

        <!-- Keeps title centered -->
        <View
            android:layout_width="48dp"
            android:layout_height="48dp" />

    </LinearLayout>


    <!-- ================= CONTENT ================= -->

    <ScrollView
        android:id="@+id/editProfileScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="20dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="36dp"
            android:paddingBottom="60dp">


            <!-- ================= COMPANY LOGO ================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/editCompanyLogo"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:padding="22dp"
                    android:src="@drawable/recruiter_dashboard_person"
                    app:tint="#2563EB"
                    android:background="#EAF1FF"
                    android:contentDescription="Company Logo"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnChangeLogo"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Change Company Logo"
                    android:textColor="#2563EB"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Change Company Logo" />

            </LinearLayout>


            <!-- ================= COMPANY INFORMATION ================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Company Information"
                android:textColor="#111827"
                android:textSize="20sp"
                android:textStyle="bold" />


            <!-- COMPANY NAME -->

            <EditText
                android:id="@+id/etCompanyName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:hint="Company Name"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="NexTech Solutions"
                android:textColor="#111827"
                android:textSize="15sp"
                android:inputType="textCapWords"
                android:singleLine="true"
                android:imeOptions="actionNext"
                android:background="@drawable/bg_recruiter_profile_input" />


            <!-- INDUSTRY -->

            <EditText
                android:id="@+id/etIndustry"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:hint="Industry"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Information Technology"
                android:textColor="#111827"
                android:textSize="15sp"
                android:inputType="textCapWords"
                android:singleLine="true"
                android:imeOptions="actionNext"
                android:background="@drawable/bg_recruiter_profile_input" />


            <!-- COMPANY SIZE -->

            <EditText
                android:id="@+id/etCompanySize"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:hint="Company Size"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="51 - 200 Employees"
                android:textColor="#111827"
                android:textSize="15sp"
                android:inputType="text"
                android:singleLine="true"
                android:imeOptions="actionNext"
                android:background="@drawable/bg_recruiter_profile_input" />


            <!-- LOCATION -->

            <EditText
                android:id="@+id/etLocation"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:hint="Location"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Mangalore, Karnataka"
                android:textColor="#111827"
                android:textSize="15sp"
                android:inputType="textCapWords"
                android:singleLine="true"
                android:imeOptions="actionNext"
                android:background="@drawable/bg_recruiter_profile_input" />


            <!-- WEBSITE -->

            <EditText
                android:id="@+id/etWebsite"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:hint="Website"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="www.nextechsolutions.com"
                android:textColor="#111827"
                android:textSize="15sp"
                android:inputType="textUri"
                android:singleLine="true"
                android:imeOptions="actionNext"
                android:background="@drawable/bg_recruiter_profile_input" />


            <!-- ================= RECRUITER INFORMATION ================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Recruiter Information"
                android:textColor="#111827"
                android:textSize="20sp"
                android:textStyle="bold" />


            <!-- RECRUITER NAME -->

            <EditText
                android:id="@+id/etRecruiterName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:hint="Recruiter Name"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Recruiter"
                android:textColor="#111827"
                android:textSize="15sp"
                android:inputType="textCapWords"
                android:singleLine="true"
                android:imeOptions="actionNext"
                android:background="@drawable/bg_recruiter_profile_input" />


            <!-- EMAIL -->

            <EditText
                android:id="@+id/etRecruiterEmail"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:hint="Email"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="recruiter@nextechsolutions.com"
                android:textColor="#111827"
                android:textSize="15sp"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                android:imeOptions="actionNext"
                android:background="@drawable/bg_recruiter_profile_input" />


            <!-- PHONE -->

            <EditText
                android:id="@+id/etRecruiterPhone"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:hint="Phone"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text=""
                android:textColor="#111827"
                android:textSize="15sp"
                android:inputType="phone"
                android:singleLine="true"
                android:imeOptions="actionNext"
                android:background="@drawable/bg_recruiter_profile_input" />


            <!-- DESIGNATION -->

            <EditText
                android:id="@+id/etDesignation"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:hint="Designation"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="HR Manager"
                android:textColor="#111827"
                android:textSize="15sp"
                android:inputType="textCapWords"
                android:singleLine="true"
                android:imeOptions="actionDone"
                android:background="@drawable/bg_recruiter_profile_input" />


            <!-- ================= SAVE BUTTON ================= -->

            <TextView
                android:id="@+id/btnSaveProfile"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="30dp"
                android:gravity="center"
                android:text="Save Changes"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_recruiter_profile_button" />


            <!-- BOTTOM SPACE -->

            <View
                android:layout_width="match_parent"
                android:layout_height="60dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>