<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CloudHire"
        tools:targetApi="31">

        <!-- ================================================= -->
        <!-- SPLASH SCREEN -->
        <!-- ================================================= -->

        <activity
            android:name=".SplashActivity"
            android:exported="true">

            <intent-filter>

                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />

            </intent-filter>

        </activity>


        <!-- ================================================= -->
        <!-- MAIN SCREEN -->
        <!-- ================================================= -->

        <activity
            android:name=".MainActivity"
            android:exported="false" />


        <!-- ================================================= -->
        <!-- GENERAL LOGIN -->
        <!-- ================================================= -->



        <!-- ================================================= -->
        <!-- CANDIDATE LOGIN -->
        <!-- ================================================= -->

        <activity
            android:name=".CandidateLoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize|stateHidden" />
        <!-- ================================================= -->
        <!-- CANDIDATE REGISTRATION -->
        <!-- ================================================= -->

        <activity
            android:name=".RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <activity
            android:name=".RecruiterLoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize|stateHidden" />


        <!-- ================================================= -->
        <!-- RECRUITER REGISTRATION -->
        <!-- ================================================= -->

        <activity
            android:name=".RecruiterRegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize|stateHidden" />


        <!-- ================================================= -->
        <!-- CANDIDATE DASHBOARD -->
        <!-- ================================================= -->

        <activity
            android:name=".CandidateDashboardActivity"
            android:exported="false" />


        <!-- ================================================= -->
        <!-- RECRUITER DASHBOARD -->
        <!-- ================================================= -->

        <activity
            android:name=".RecruiterDashboardActivity"
            android:exported="false" />

    </application>

</manifest>